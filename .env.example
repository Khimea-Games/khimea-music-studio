# Puerto del servidor (por defecto 3000)
PORT=3000

# Dirección donde escucha (por defecto 127.0.0.1, sólo esta máquina). La API no tiene autenticación:
# con 0.0.0.0 cualquiera en tu red puede usarla.
# HOST=127.0.0.1

# Intérprete de Python para el renderizador (por defecto: python en Windows, python3 en el resto)
# PYTHON_BIN=python3

# Carpeta de una biblioteca de efectos propia con su CATALOGO.tsv (sólo para search_sfx / export_sfx)
# KHIMEA_SFX_LIBRARY=/ruta/a/tu/biblioteca-sfx
